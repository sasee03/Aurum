# Aurum database configuration (placeholder values only — copy to .env and edit).
# Supports local pgAdmin-managed PostgreSQL, Docker, or remote Postgres via DATABASE_URL.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=aurum
DB_USER=postgres
DB_PASSWORD=change_me
DB_CONNECT_TIMEOUT=3

# Legacy aliases (still supported; DB_* takes precedence when both are set):
# AURUM_POSTGRES_HOST=localhost
# AURUM_POSTGRES_PORT=5433
# AURUM_POSTGRES_DB=aurum
# AURUM_POSTGRES_USER=aurum
# AURUM_POSTGRES_PASSWORD=aurum

# Optional: full connection string for remote/cloud Postgres (e.g. Neon).
# When set, DATABASE_URL takes precedence over DB_* / AURUM_POSTGRES_* above.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
