# Office laptop — pgAdmin + local PostgreSQL (placeholder values only).
# Copy to .env and replace change_me with your local postgres password.
#
#   copy .env.office.example .env
#
# pgAdmin is only a GUI — the PostgreSQL Windows service must be running.
# See docs/OFFICE_POSTGRES_SETUP.md
#
# CANONICAL OFFICE VALUES (use these exactly — do not guess):
#   DB_PORT = 5433   DB_NAME = aurum   DB_USER = postgres
# These match src/db_config.py defaults. If /health reports
# "database": "unreachable", it is almost always because the local PostgreSQL
# service is stopped OR your install listens on 5432 instead of 5433 — confirm
# with `Get-Service *postgres*` and pgAdmin's server port, then set DB_PORT to
# the ONE port your service actually uses. Do not leave it ambiguous.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=aurum
DB_USER=postgres
DB_PASSWORD=change_me
DB_CONNECT_TIMEOUT=3
